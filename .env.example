# Copy to .env and adjust. NEVER commit .env.
# Hostnames here are as seen FROM YOUR LAPTOP. Inside the compose network,
# containers reach each other by service name instead (postgres:5432, kafka:29092).

# Postgres (source "retailer" OLTP)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=retail

# Kafka
KAFKA_BOOTSTRAP=kafka:29092
TOPIC_ONLINE=online_orders
TOPIC_POS=store_pos
TOPIC_DLQ=sales_dlq
