# containers reach each other by service name instead (postgres:5432, kafka:29092).

# Postgres 
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=retail

# Kafka
KAFKA_BOOTSTRAP=kafka:29092
TOPIC_ONLINE=online_orders
TOPIC_POS=store_pos
TOPIC_DLQ=sales_dlq

# Simulator knobs
EVENTS_PER_SEC=20          # combined basket/order emit rate for live producers
ONLINE_SHARE=0.3           # fraction of live events that are online orders
BACKFILL_MONTHS=6
POS_DELAY_SCALE=1.0        # scale POS flush delays; set 0.05 in dev to see rows fast
SHOPPERS_PER_STORE_DAY=150 # mean baskets per store-day in backfill
